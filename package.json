  },
  "devDependencies": {
    "@angular/build": "^21.2.14",
    "@angular/cli": "^21.2.14",
    "@angular/compiler-cli": "^21.2.0",
    "@tailwindcss/postcss": "^4.1.12",
    "concurrently": "^10.0.3",
    "jsdom": "^28.0.0",
    "json-server": "^1.0.0-beta.15",
